node_modules/

# Build output. Assembled by `npm run build`; load this in Chrome.
dist/

# Store upload artifacts, produced by `npm run zip`.
artifacts/
*.zip

# Your Google OAuth client ID and your pinned extension key. These identify
# *your* Cloud project, so they stay out of the repository. The build reads them
# and writes them into dist/manifest.json. See README.md -> Setup.
client-id.local
extension-key.local

.DS_Store

# Everything written for an assistant rather than for the project: the running
# notes in ai/NOTES.md, the standing instructions in ai/README.md, task handoffs,
# review passes, and whatever throwaway probes a session leaves behind. None of it
# is reviewed, none of it should be, and it carries absolute paths and dates from
# whichever machine it was written on.
#
# What belongs in the repository instead: anything true about the *extension*
# rather than about the work of changing it. Put that in a comment beside the code,
# or in README.md if a user needs it.
ai/
