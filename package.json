{
  "name": "2fa-paster",
  "version": "1.3.0",
  "private": true,
  "description": "Development manifest for the 2FA Paster test suite. The extension itself ships without dependencies.",
  "type": "module",
  "scripts": {
    "clean": "node scripts/build.mjs --clean-only",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "zip": "node scripts/build.mjs --zip",
    "icons": "node scripts/icons.mjs",
    "store:assets": "npm run build && node scripts/store-shots.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:browser": "node tests/browser/run.mjs",
    "verify": "npm run test && npm run build && npm run test:browser"
  }
}
